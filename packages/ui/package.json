{
  "name": "@titakin/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./styles/global.css": "./src/styles/global.css",
    "./tailwind.config": "./tailwind.config.ts"
  },
  "scripts": {
    "dev": "storybook dev --port 6006 --no-open",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules storybook-static"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@titakin/config": "workspace:*",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.25.0",
    "eslint-plugin-storybook": "^10.6.1",
    "postcss": "^8.5.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^8.3.2"
  }
}
